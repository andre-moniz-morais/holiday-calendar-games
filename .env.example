# Postgres connection string.
#   Local dev (docker on port 5433): postgres://natal:natal@localhost:5433/natal
#   Mac mini (docker_shared_network): postgres://natal:<password>@<postgres-container-name>:5432/natal
DATABASE_URL=postgres://natal:natal@localhost:5433/natal

# Long random string used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Year of the advent calendar (December of this year). Baked into the build.
NEXT_PUBLIC_CALENDAR_YEAR=2026

# Optional: override the two passwords (default: Duda / Filipino).
# PASSWORD_DUDA=
# PASSWORD_FILIPINO=

# DEV ONLY: pretend today is this day of December (0 = before Dec 1, 1-25, 26 = after Christmas).
# Leave empty in production.
DEV_TODAY=
