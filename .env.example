# Postgres connection string (Neon / Supabase / Vercel Postgres / local docker)
DATABASE_URL=postgres://natal:natal@localhost:5433/natal

# Long random string used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Year of the advent calendar (December of this year)
NEXT_PUBLIC_CALENDAR_YEAR=2026

